<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/alarmIcon"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/alarm_circle"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="@string/ready_title"
        android:textColor="@color/text"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmTea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/muted"
        android:textSize="18sp" />

    <Button
        android:id="@+id/alarmStop"
        style="@style/TeaButton.Primary"
        android:layout_width="match_parent"
        android:layout_marginTop="56dp"
        android:minHeight="72dp"
        android:text="@string/stop_alarm"
        android:textSize="22sp" />

    <Button
        android:id="@+id/alarmOpen"
        style="@style/TeaButton.Text"
        android:layout_marginTop="12dp"
        android:text="@string/stop_and_open" />
</LinearLayout>
